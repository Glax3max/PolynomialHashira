{
  "functions": {
    "source": ".",
    "runtime": "nodejs20",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" ci", "npm --prefix \"$RESOURCE_DIR\" run build"],
    "ignore": [
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".firebase/**",
      ".git/**",
      "**/.git/**",
      "**/node_modules/**"
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "**", "function": "api" }
    ]
  }
}

